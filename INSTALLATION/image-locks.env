# Image inputs used by the Docker fixtures.  This is the linux/amd64
# single-platform manifest for Alpine 3.20 (currently 3.20.10), obtained with
# `docker buildx imagetools inspect alpine:3.20` on 2026-08-22.  Keep the full
# tag@digest reference: a mutable tag alone is not reproducible.
NIEP_ALPINE_IMAGE=alpine:3.20
NIEP_ALPINE_DIGEST=sha256:c64c687cbea9300178b30c95835354e34c4e4febc4badfe27102879de0483b5e
NIEP_ALPINE_REFERENCE=alpine:3.20@sha256:c64c687cbea9300178b30c95835354e34c4e4febc4badfe27102879de0483b5e

# These images are built locally from the repository Dockerfiles.  A digest is
# intentionally not fabricated: the image ID is host/build dependent.  The
# doctor reports whether they have been built and checks their pinned Alpine
# base when the daemon exposes it.
NIEP_TEST_IMAGE=niep/iperf3-test:local
NIEP_TUTORIAL_IMAGE=niep/iperf3:local
