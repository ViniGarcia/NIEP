#!/sbin/openrc-run
# NIEP fixes the management NIC at PCI slot 03; other NIC names are discovered.
description="Generate interface configuration from PCI identity and optional MAC mappings"
depend() {
    need localmount
    after mdev hwdrivers
    before networking
}
# NIEP_STARTUP_ADDRESSING_V2
# 02:01:00:xx:xx:xx encodes a zero-based shared-LAN endpoint index in 10.0.0.0/8.
startup_address() {
    case "$1" in
        02:01:00:??:??:??) ;;
        *) return 1;;
    esac
    old_ifs=$IFS
    IFS=:
    set -- $1
    IFS=$old_ifs
    index=$((0x$4 * 65536 + 0x$5 * 256 + 0x$6))
    [ "$index" -lt 16777213 ] || return 1
    value=$((index + 2))
    printf '10.%d.%d.%d/8' "$(((value >> 16) & 255))" "$(((value >> 8) & 255))" "$((value & 255))"
}
start() {
    ebegin "Configuring NIEP interfaces"
    printf 'auto lo\niface lo inet loopback\n' > /etc/network/interfaces
    for device in /sys/class/net/*; do
        iface=${device##*/}
        [ "$iface" != lo ] || continue
        mac=$(cat "$device/address")
        address=$(awk -v mac="$mac" 'tolower($1) == mac {print $2; exit}' /etc/niep-network.conf)
        if [ -z "$address" ]; then
            address=$(startup_address "$mac") || address=''
        fi
        if [ -z "$address" ]; then
            case $(readlink -f "$device/device") in
                */0000:00:03.0|*/0000:00:03.0/*) address=dhcp;;
                *) address=manual;;
            esac
        fi
        printf '\nauto %s\n' "$iface" >> /etc/network/interfaces
        case $address in
            dhcp|manual) printf 'iface %s inet %s\n' "$iface" "$address";;
            *) printf 'iface %s inet static\n    address %s\n' "$iface" "$address";;
        esac >> /etc/network/interfaces
    done
    eend 0
}
